#!/usr/bin/env bash
# runlens-hook — thin wrapper invoked by agent lifecycle hooks.
# Routes event data into ~/.local/share/runlens/hooks.jsonl
#
# CONTRACT (do not break): a lifecycle hook is best-effort telemetry. This
# script MUST NEVER crash or block the host agent. Concretely:
#   - always exit 0, even when uv/runlens cannot be found or the CLI errors;
#   - write nothing to stdout (agents may parse stdout as a hook protocol reply);
#   - never let stderr noise escape.
# GUI-launched agents (e.g. Cursor IDE) spawn hooks with a minimal PATH that
# lacks Homebrew/mise, so we cannot rely on PATH to locate uv — we probe known
# install locations ourselves.

HOOK_VERSION="0.2.0"

# GUI apps give us a minimal PATH. Prepend common tool locations so `uv`
# (Homebrew / mise / pipx / cargo) is discoverable regardless of how we were
# spawned. Harmless if some of these directories do not exist.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/share/mise/shims:$HOME/.cargo/bin:$PATH"

# Drain stdin unconditionally so the caller's pipe never blocks or SIGPIPEs,
# even if we end up doing nothing with the payload.
stdin_data="$(cat 2>/dev/null || true)"

# Everything below is best-effort and fully sandboxed: stdout is discarded and
# any failure is swallowed so the script always reaches `exit 0`.
{
    # Resolve the RunLens project root near this script or at the known path.
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || true)"
    if [ -L "${BASH_SOURCE[0]}" ]; then
        real_src="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
        [ -n "$real_src" ] && script_dir="$(cd "$(dirname "$real_src")" 2>/dev/null && pwd || true)"
    fi

    repo_root=""
    for candidate in "$script_dir" "$script_dir/.." "$HOME/claw_prog/projects/04-kurisu-github/RunLens"; do
        if [ -n "$candidate" ] && [ -f "$candidate/pyproject.toml" ]; then
            repo_root="$candidate"
            break
        fi
    done

    if [ -n "$repo_root" ] && command -v uv >/dev/null 2>&1; then
        printf '%s' "$stdin_data" | uv run --project "$repo_root" runlens hook "$@"
    elif command -v runlens >/dev/null 2>&1; then
        printf '%s' "$stdin_data" | runlens hook "$@"
    fi
    # No runtime found → silently do nothing. The host agent must not notice.
} >/dev/null 2>&1 || true

exit 0
